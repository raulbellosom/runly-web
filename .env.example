# Site
PUBLIC_SITE_URL=https://runly.mx

# reCAPTCHA v3 site key (spam protection on the contact form).
# This is exposed to the browser (Astro's PUBLIC_ prefix), safe to expose.
PUBLIC_RECAPTCHA_SITE_KEY=

# External contact API the static site posts the form to, e.g.:
# PUBLIC_CONTACT_API_URL=https://api.runly.mx/public/contact
# Also public (it's just a URL, no secret). Leave blank in builds where no
# contact backend is deployed yet — the form will show an error on submit
# instead of silently pretending to succeed. See contact-api-reference/
# for what that backend needs to implement (SMTP + reCAPTCHA secret live
# there, never in this frontend build).
PUBLIC_CONTACT_API_URL=
