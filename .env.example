# Site
PUBLIC_SITE_URL=https://runly.mx

# Contact form -> Runly ERP's Growth module, via @raulbellosom/runly-sdk.
# All values below are public by design (same category as a Supabase anon
# key or a reCAPTCHA site key): they get inlined into the static build and
# shipped to the browser. No SMTP credentials or server secrets live here or
# anywhere in this repo — the Growth module owns delivery once submitted.

# Your Runly ERP instance's API. Copy this from the "apiUrl" field in Growth →
# Sitios conectados → (this site) → Ver código — do not assume it's just the
# bare domain, the instance may mount the API under a subpath (e.g. `/api`).
PUBLIC_RUNLY_API_URL=https://app.runly.mx/api

# Company slug assigned to this site inside that ERP instance.
PUBLIC_RUNLY_COMPANY=

# This site's UUID inside the ERP's Website module (scopes form submissions
# to runly.mx). Leave blank until runly.mx is registered as a site there.
PUBLIC_RUNLY_SITE_ID=

# UUID of the "contacto" form created in the Growth module's admin. Its field
# keys must match what ContactSection.astro submits (fullName, companyName,
# email, phone, teamSize, interest, needs, consent, locale).
PUBLIC_RUNLY_CONTACT_FORM_ID=

# Needed for the guestChat live-chat widget's real-time replies (falls back
# to no-op without them) — not needed for the contact form itself, which
# works without a Supabase session. Copy exactly from the same "Ver código"
# snippet as PUBLIC_RUNLY_API_URL above.
PUBLIC_RUNLY_SUPABASE_URL=
PUBLIC_RUNLY_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (optional spam protection on the contact
# form). Leave blank to skip Turnstile entirely — the form still submits.
PUBLIC_TURNSTILE_SITE_KEY=
