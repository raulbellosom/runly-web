# SMTP (required for the contact form to actually send email, see docs/superpowers/specs/2026-09-21-runly-web-landing-design.md section 7)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Runly <no-reply@runly.mx>"
CONTACT_TO_EMAIL=

# Site
PUBLIC_SITE_URL=https://runly.mx

# reCAPTCHA v3 (spam protection on the contact form)
# PUBLIC_RECAPTCHA_SITE_KEY is exposed to the browser (Astro's PUBLIC_ prefix), safe to expose.
# RECAPTCHA_SECRET_KEY is server-only, NEVER commit a real value here.
# If RECAPTCHA_SECRET_KEY is left blank, the contact form skips verification entirely
# (useful for local dev without needing real keys) instead of blocking submissions.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
