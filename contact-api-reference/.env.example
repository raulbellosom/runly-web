# Reference only — env vars the real Runly backend/API needs when it
# implements POST /public/contact (see README.md in this folder).
# These must NEVER be added back to runly-web's own .env/.env.example:
# runly-web is a static build and no longer runs this code.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Runly <no-reply@runly.mx>"
CONTACT_TO_EMAIL=

# If blank, reCAPTCHA verification is skipped (useful for local dev only —
# the production backend should always have this set).
RECAPTCHA_SECRET_KEY=
