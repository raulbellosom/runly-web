---
// src/components/sections/WhyChooseSection.astro
//
// Bento-style differentiator grid: one large "anchor" tile (index 0) and one
// wide tile (index 4, the MirAI one — ties narratively into MiraiTeaserSection
// right below on the homepage) among six regular tiles. grid-flow-row-dense +
// a fixed auto-rows unit lets the smaller tiles pack around the two feature
// tiles without manual per-breakpoint positioning.
import SectionHeading from "../ui/SectionHeading.astro";
import { resolveIcon } from "../../lib/icons";
import type { SiteDictionary } from "../../i18n/types";

interface Props {
  dict: SiteDictionary;
}

const { dict } = Astro.props;
const { whyChoose } = dict;

const badgeGradient: Record<string, string> = {
  orange: "from-orange-500 to-amber-400 shadow-orange-500/30",
  emerald: "from-emerald-500 to-teal-400 shadow-emerald-500/30",
  blue: "from-blue-600 to-sky-400 shadow-blue-500/30",
  purple: "from-purple-600 to-fuchsia-400 shadow-purple-500/30",
  pink: "from-pink-600 to-rose-400 shadow-pink-500/30",
  amber: "from-amber-500 to-yellow-400 shadow-amber-500/30",
  cyan: "from-cyan-500 to-sky-400 shadow-cyan-500/30",
  indigo: "from-indigo-600 to-violet-400 shadow-indigo-500/30",
};

const borderHover: Record<string, string> = {
  orange: "hover:border-orange-300",
  emerald: "hover:border-emerald-300",
  blue: "hover:border-blue-300",
  purple: "hover:border-purple-300",
  pink: "hover:border-pink-300",
  amber: "hover:border-amber-300",
  cyan: "hover:border-cyan-300",
  indigo: "hover:border-indigo-300",
};

const blobColor: Record<string, string> = {
  orange: "bg-orange-400/20",
  purple: "bg-purple-400/20",
};
---

<section class="py-24 bg-white border-b border-slate-200 relative overflow-hidden">
  <div data-parallax="0.1" class="absolute top-0 right-0 w-[500px] h-[500px] bg-orange-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div data-parallax="0.08" class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <SectionHeading eyebrow={whyChoose.eyebrow} title={whyChoose.title} description={whyChoose.description} />

    <div class="bento-stagger reveal-on-scroll grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[168px] lg:grid-flow-row-dense gap-5">
      {whyChoose.cards.map((card, i) => {
        const Icon = resolveIcon(card.icon);
        const isBig = i === 0;
        const isWide = i === 4;
        return (
          <div
            class:list={[
              "group relative rounded-2xl border border-slate-200/80 bg-slate-50 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:bg-white",
              borderHover[card.color],
              isBig ? "sm:col-span-2 lg:col-span-2 lg:row-span-2 p-8 flex flex-col justify-center" : "p-6 flex flex-col justify-center",
              isWide && "sm:col-span-2 lg:col-span-2",
            ]}
          >
            {isBig && <div class={`absolute -top-10 -right-10 w-40 h-40 rounded-full blur-3xl transition-opacity duration-300 opacity-60 group-hover:opacity-90 ${blobColor[card.color] ?? "bg-orange-400/20"}`} />}
            <div
              class:list={[
                "relative rounded-xl flex items-center justify-center text-white shadow-lg transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3 bg-gradient-to-br",
                badgeGradient[card.color],
                isBig ? "w-16 h-16 mb-5" : "w-11 h-11 mb-4",
              ]}
            >
              <Icon class={isBig ? "w-7 h-7" : "w-5 h-5"} />
            </div>
            <h3 class:list={["relative font-bold text-slate-900 mb-1.5", isBig ? "text-2xl" : "text-base"]}>{card.title}</h3>
            <p class:list={["relative text-slate-600 leading-relaxed", isBig ? "text-base max-w-sm" : "text-xs"]}>{card.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
