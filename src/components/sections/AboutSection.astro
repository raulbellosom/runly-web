---
// src/components/sections/AboutSection.astro
//
// Was plain centered paragraphs with no visual at all — the flattest
// section on the homepage. Now a two-column layout: copy on the left,
// a decorative dark panel on the right (isotype + floating badges reusing
// the same three short claims Hero.astro already makes inline, so nothing
// new is asserted — just presented with more visual weight here).
import { Boxes, BuildingComplex, SlidersHorizontal } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { SiteDictionary } from "../../i18n/types";

interface Props {
  dict: SiteDictionary;
}

const { dict } = Astro.props;
const { about, hero } = dict;

const badges = [
  { icon: Boxes, label: hero.badgeModular, color: "text-orange-300 bg-orange-500/15" },
  { icon: BuildingComplex, label: hero.badgeMultiCompany, color: "text-blue-300 bg-blue-500/15" },
  { icon: SlidersHorizontal, label: hero.badgeCustomizable, color: "text-emerald-300 bg-emerald-500/15" },
];
---

<section class="py-20 sm:py-24 bg-white" id="acerca-de">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 reveal-on-scroll">
        <SectionHeading eyebrow={about.eyebrow} title={about.title} align="left" />
        <div class="space-y-4 -mt-6">
          {about.paragraphs.map((paragraph) => <p class="text-base text-slate-600 leading-relaxed">{paragraph}</p>)}
        </div>
      </div>

      <div class="lg:col-span-6 reveal-on-scroll">
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-slate-900 via-runly-midnight to-slate-950 min-h-[340px] sm:min-h-[380px] flex items-center justify-center">
          <div class="absolute inset-0 bg-grid-pattern-dark"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 bg-orange-500/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-16 -left-10 w-64 h-64 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>

          <img
            src="/brand/runly-isotipo-dark.png"
            alt=""
            aria-hidden="true"
            class="relative w-20 h-20 sm:w-24 sm:h-24 object-contain drop-shadow-2xl animate-float"
            width="96"
            height="96"
            loading="lazy"
          />

          {badges.map((badge, i) => (
            <div
              class:list={[
                "hidden sm:flex items-center gap-2 absolute px-3.5 py-2 rounded-xl glass-card-dark border border-white/10 shadow-glass-dark",
                i === 0 && "top-8 left-6",
                i === 1 && "bottom-10 right-6",
                i === 2 && "top-12 right-10 lg:right-14",
              ]}
            >
              <div class={`w-7 h-7 rounded-lg flex items-center justify-center shrink-0 ${badge.color}`}>
                <badge.icon class="w-3.5 h-3.5" />
              </div>
              <span class="text-xs font-semibold text-white whitespace-nowrap">{badge.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
