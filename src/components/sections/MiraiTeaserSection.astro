---
// src/components/sections/MiraiTeaserSection.astro
//
// Compact homepage teaser for MirAI — the full feature page (capabilities
// list + hand-built chat mockup demo) lives at /mirai
// (MiraiSection.astro). This teaser instead frames a real product
// screenshot (public/brand/mirai-chat-preview.png, a light-mode capture of
// the actual Chat module with MirAI) in the same dark browser-chrome style
// Hero.astro uses for the light-mode dashboard shot, so the homepage gets a
// real visual instead of more prose.
import { Sparkles, ArrowRight } from "@lucide/astro";
import type { SiteDictionary } from "../../i18n/types";

interface Props {
  dict: SiteDictionary;
  locale: "es" | "en";
}

const { dict, locale } = Astro.props;
const { mirai } = dict;
const prefix = locale === "es" ? "" : "/en";
---

<section class="py-24 bg-gradient-to-b from-runly-navy via-[#0A1024] to-runly-midnight text-white relative overflow-hidden reveal-on-scroll">
  <div data-parallax="0.12" class="absolute top-1/4 -left-20 w-96 h-96 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>
  <div data-parallax="0.08" class="absolute bottom-0 -right-20 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/60 border border-purple-500/40 text-purple-300 text-xs font-semibold mb-4">
          <Sparkles class="w-3.5 h-3.5" /> {mirai.badge}
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">
          {mirai.title} <span class="text-gradient-orange">{mirai.titleHighlight}</span>
        </h2>
        <p class="text-base text-slate-300 leading-relaxed mb-8">{mirai.description}</p>
        <a
          href={`${prefix}/mirai`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-semibold text-sm runly-gradient-btn shadow-md w-fit transition-transform hover:-translate-y-0.5"
        >
          <span>{mirai.teaserCta}</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
      <div class="lg:col-span-7">
        <div class="relative">
          <div class="relative rounded-2xl p-2 bg-gradient-to-b from-slate-700/60 via-slate-800/60 to-slate-700/30 shadow-2xl border border-slate-700/60">
            <div class="bg-slate-950 rounded-xl overflow-hidden shadow-inner border border-slate-800">
              <div class="h-8 px-4 bg-slate-950/90 flex items-center gap-2 border-b border-slate-800/80">
                <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
              </div>
              <img
                alt={mirai.previewAlt}
                class="w-full h-auto object-cover select-none"
                src="/brand/mirai-chat-preview.png"
                width="1916"
                height="941"
                loading="lazy"
              />
            </div>
          </div>
          <div class="hidden sm:flex items-center gap-3 absolute -bottom-6 -left-6 p-3.5 rounded-xl glass-card-dark shadow-glass-dark border border-white/10">
            <div class="w-10 h-10 rounded-lg bg-purple-500/20 text-purple-300 flex items-center justify-center shrink-0">
              <Sparkles class="w-5 h-5" />
            </div>
            <p class="text-xs font-semibold text-white whitespace-nowrap">{mirai.demoLabel}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
