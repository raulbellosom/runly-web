---
// src/components/sections/ModulesCatalogSection.astro
//
// Condensed homepage teaser: a handful of flip cards (not the full 21) so
// the landing page doesn't get overloaded, plus a CTA into the dedicated
// /modulos catalog page (src/pages/modulos.astro), which has the full grid,
// category filters, and the roadmap section.
import SectionHeading from "../ui/SectionHeading.astro";
import ModuleFlipCard from "../ui/ModuleFlipCard.astro";
import { modules } from "../../data/modules";
import type { SiteDictionary } from "../../i18n/types";

interface Props {
  dict: SiteDictionary;
  locale: "es" | "en";
}

const { dict, locale } = Astro.props;
const { modulesCatalog } = dict;
const prefix = locale === "es" ? "" : "/en";

const featuredIds = ["runly.core", "runly.contacts", "runly.pos", "runly.ledger", "runly.projects", "runly.chat"];
const featured = featuredIds
  .map((id) => modules.find((m) => m.id === id))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));
---

<section class="py-24 bg-white relative" id="modulos">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={modulesCatalog.eyebrow} title={modulesCatalog.title} description={modulesCatalog.description} />

    <div class="rounded-3xl overflow-hidden border border-slate-200 bg-slate-200 mb-10">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-px">
        {featured.map((mod) => (
          <ModuleFlipCard module={mod} locale={locale} />
        ))}
      </div>
    </div>

    <div class="flex justify-center">
      <a
        href={`${prefix}/modulos`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold runly-gradient-btn text-white shadow-sm hover:shadow-md transition-all"
      >
        {modulesCatalog.viewAllCta}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
