---
// src/components/sections/MiraiSection.astro
import { Sparkles, MessageCircle, FileText, Brain, ShieldCheck, CircleCheck } from "@lucide/astro";
import type { SiteDictionary } from "../../i18n/types";

interface Props {
  dict: SiteDictionary;
}

const { dict } = Astro.props;
const { mirai } = dict;

const iconMap = { MessageCircle, FileText, Brain, ShieldCheck } as const;
const colorMap: Record<string, string> = {
  purple: "bg-purple-500/20 text-purple-400",
  orange: "bg-orange-500/20 text-orange-400",
  blue: "bg-blue-500/20 text-blue-400",
  emerald: "bg-emerald-500/20 text-emerald-400",
};
---

<section class="py-24 bg-gradient-to-b from-runly-navy via-[#0A1024] to-runly-midnight text-white relative overflow-hidden reveal-on-scroll" id="mirai">
  <div class="absolute top-1/3 left-10 w-96 h-96 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-900/60 border border-purple-500/40 text-purple-300 text-xs font-semibold mb-4">
        <Sparkles class="w-3.5 h-3.5" /> {mirai.badge}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        {mirai.title} <span class="text-gradient-orange">{mirai.titleHighlight}</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300">{mirai.description}</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5 space-y-6">
        {mirai.capabilities.map((cap) => {
          const Icon = iconMap[cap.icon as keyof typeof iconMap];
          return (
            <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-purple-500/50 transition-colors">
              <div class="flex items-start gap-4">
                <div class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 mt-1 ${colorMap[cap.color]}`}>
                  <Icon class="w-4 h-4" />
                </div>
                <div>
                  <h3 class="text-base font-bold text-white">{cap.title}</h3>
                  <p class="text-xs text-slate-300 mt-1 leading-relaxed">{cap.description}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-slate-700 bg-slate-900/90 shadow-2xl p-4 sm:p-6 backdrop-blur-xl">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center text-white shadow-md">
                <Sparkles class="w-4 h-4" />
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h4 class="font-bold text-white text-sm">{mirai.demoLabel}</h4>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-semibold">{mirai.demoContext}</span>
                </div>
                <p class="text-xs text-slate-400">{mirai.demoDisclaimer}</p>
              </div>
            </div>
          </div>
          <div
            id="miraiDemoConversation"
            class="py-6 space-y-4 text-xs sm:text-sm font-normal"
            data-default-user={mirai.demoScenarios[0].userMessage}
            data-default-intro={mirai.demoScenarios[0].assistantIntro}
            data-default-line1={mirai.demoScenarios[0].lines[0]}
            data-default-line2={mirai.demoScenarios[0].lines[1]}
            data-default-highlight={mirai.demoScenarios[0].highlightLine}
            data-default-confirmation={mirai.demoScenarios[0].confirmation}
          >
            <div class="flex items-start justify-end gap-2.5">
              <div class="bg-blue-600 text-white p-3.5 rounded-2xl rounded-tr-none max-w-[85%]">
                <p id="miraiDemoUser">{mirai.demoScenarios[0].userMessage}</p>
              </div>
            </div>
            <div class="flex items-start gap-2.5">
              <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center text-white shrink-0">
                <Sparkles class="w-3 h-3" />
              </div>
              <div class="bg-slate-800/90 border border-slate-700/80 text-slate-200 p-4 rounded-2xl rounded-tl-none max-w-[90%] space-y-2">
                <p id="miraiDemoIntro">{mirai.demoScenarios[0].assistantIntro}</p>
                <div class="p-3 bg-slate-900/80 rounded-xl border border-slate-700/50 text-xs font-mono space-y-1">
                  <div class="flex justify-between text-slate-300"><span id="miraiDemoLine1">{mirai.demoScenarios[0].lines[0]}</span></div>
                  <div class="flex justify-between text-slate-300"><span id="miraiDemoLine2">{mirai.demoScenarios[0].lines[1]}</span></div>
                  <div class="border-t border-slate-700 pt-1 mt-1 flex justify-between text-white font-bold"><span id="miraiDemoHighlight">{mirai.demoScenarios[0].highlightLine}</span></div>
                </div>
                <p class="text-slate-300 text-xs"><CircleCheck class="w-3.5 h-3.5 text-emerald-400 inline mr-1" /> <span id="miraiDemoConfirmation">{mirai.demoScenarios[0].confirmation}</span></p>
              </div>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-800 flex flex-wrap gap-2 text-xs">
            <span class="text-slate-400 text-[11px] self-center">{mirai.demoPromptsLabel}</span>
            {[mirai.demoPrompt1, mirai.demoPrompt2].map((label, i) => (
              <button
                class="mirai-demo-prompt px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 data-[active=true]:bg-purple-600 data-[active=true]:text-white data-[active=true]:border-purple-500 transition-colors"
                type="button"
                data-scenario={i + 1}
                data-user={mirai.demoScenarios[i + 1].userMessage}
                data-intro={mirai.demoScenarios[i + 1].assistantIntro}
                data-line1={mirai.demoScenarios[i + 1].lines[0]}
                data-line2={mirai.demoScenarios[i + 1].lines[1]}
                data-highlight={mirai.demoScenarios[i + 1].highlightLine}
                data-confirmation={mirai.demoScenarios[i + 1].confirmation}
                data-active="false"
                aria-pressed="false"
              >
                {label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Clicking a suggested prompt swaps the demo conversation to that
  // scenario's canned Q&A (see mirai.demoScenarios in the i18n dicts) —
  // these buttons used to be aria-disabled decoration that looked
  // clickable but did nothing.
  const prompts = document.querySelectorAll<HTMLButtonElement>(".mirai-demo-prompt");
  const conversation = document.getElementById("miraiDemoConversation");
  const fields = {
    user: document.getElementById("miraiDemoUser"),
    intro: document.getElementById("miraiDemoIntro"),
    line1: document.getElementById("miraiDemoLine1"),
    line2: document.getElementById("miraiDemoLine2"),
    highlight: document.getElementById("miraiDemoHighlight"),
    confirmation: document.getElementById("miraiDemoConfirmation"),
  };

  if (prompts.length && conversation && Object.values(fields).every(Boolean)) {
    const applyScenario = (source: DOMStringMap) => {
      fields.user!.textContent = source.user ?? source.defaultUser ?? "";
      fields.intro!.textContent = source.intro ?? source.defaultIntro ?? "";
      fields.line1!.textContent = source.line1 ?? source.defaultLine1 ?? "";
      fields.line2!.textContent = source.line2 ?? source.defaultLine2 ?? "";
      fields.highlight!.textContent = source.highlight ?? source.defaultHighlight ?? "";
      fields.confirmation!.textContent = source.confirmation ?? source.defaultConfirmation ?? "";
    };

    prompts.forEach((button) => {
      button.addEventListener("click", () => {
        const isActive = button.dataset.active === "true";
        prompts.forEach((b) => {
          b.dataset.active = "false";
          b.setAttribute("aria-pressed", "false");
        });

        if (isActive) {
          applyScenario(conversation.dataset); // back to the default scenario
          return;
        }

        button.dataset.active = "true";
        button.setAttribute("aria-pressed", "true");
        applyScenario(button.dataset);
      });
    });
  }
</script>
