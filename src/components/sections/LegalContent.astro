---
// src/components/sections/LegalContent.astro
import type { LegalPageDictionary } from "../../i18n/types";

interface Props {
  page: LegalPageDictionary;
}

const { page } = Astro.props;
---

<section class="py-20 sm:py-24 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <span class="text-xs font-bold text-orange-600 uppercase tracking-widest px-3 py-1 rounded-full bg-orange-100">{page.eyebrow}</span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-4">{page.title}</h1>
    <p class="mt-2 text-xs font-semibold text-slate-400">{page.lastUpdated}</p>
    <p class="mt-6 text-base text-slate-600 leading-relaxed">{page.intro}</p>

    <div class="mt-12 space-y-10">
      {page.sections.map((section) => (
        <div>
          <h2 class="text-xl font-bold text-slate-900 tracking-tight">{section.heading}</h2>
          <div class="mt-3 space-y-3 text-sm text-slate-600 leading-relaxed">
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {section.list && (
            <ul class="mt-3 space-y-2 text-sm text-slate-600 leading-relaxed list-disc pl-5">
              {section.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
