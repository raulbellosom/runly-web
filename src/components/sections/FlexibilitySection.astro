---
// src/components/sections/FlexibilitySection.astro
import { Puzzle, Zap, BuildingComplex, TrendingUp } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { SiteDictionary } from "../../i18n/types";

interface Props {
  dict: SiteDictionary;
}

const { dict } = Astro.props;
const { flexibility } = dict;

// Dictionary content still stores the icon name as "Building2" (matching the
// real product's own icon choice) — mapped here to the non-deprecated
// @lucide/astro export so the rendered icon and the type-checker both stay clean.
const iconMap = { PuzzlePiece: Puzzle, Zap, Building2: BuildingComplex, TrendingUp } as const;
const badgeGradient: Record<string, string> = {
  orange: "from-orange-500 to-amber-400 shadow-orange-500/30",
  blue: "from-blue-600 to-sky-400 shadow-blue-500/30",
  purple: "from-purple-600 to-fuchsia-400 shadow-purple-500/30",
  emerald: "from-emerald-500 to-teal-400 shadow-emerald-500/30",
};
const borderHover: Record<string, string> = {
  orange: "hover:border-orange-300",
  blue: "hover:border-blue-300",
  purple: "hover:border-purple-300",
  emerald: "hover:border-emerald-300",
};
---

<section class="py-20 bg-slate-50/70 border-y border-slate-200/70 relative overflow-hidden">
  <div class="absolute top-0 right-1/4 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <SectionHeading eyebrow={flexibility.eyebrow} title={flexibility.title} description={flexibility.description} />
    <div class="bento-stagger reveal-on-scroll grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {flexibility.cards.map((card) => {
        const Icon = iconMap[card.icon as keyof typeof iconMap];
        return (
          <div class={`group glass-card p-7 rounded-2xl border border-transparent transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${borderHover[card.color]}`}>
            <div
              class={`w-12 h-12 rounded-xl flex items-center justify-center mb-5 text-white shadow-lg bg-gradient-to-br transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3 ${badgeGradient[card.color]}`}
            >
              <Icon class="w-5 h-5" />
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">{card.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{card.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
