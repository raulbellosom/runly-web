---
// src/components/sections/Hero.astro
import { Boxes, BuildingComplex, SlidersHorizontal, Lock, Network, Sparkles } from "@lucide/astro";
import { Image } from "astro:assets";
import type { SiteDictionary } from "../../i18n/types";
import tourInicio from "../../assets/tour/inicio.png";
import tourCalendario from "../../assets/tour/calendario.png";
import tourEmpresa from "../../assets/tour/empresa.png";

interface Props {
  dict: SiteDictionary;
}

const { dict } = Astro.props;
const { hero } = dict;

// Paired by index with hero.tourTabs (label/alt come from the dict so they
// stay bilingual; the images are a code concern, not a translation one).
// Imported through astro:assets so they ship as responsive WebP instead of
// full-size PNGs, and all three render up front so switching tabs is instant.
const tourImages = [tourInicio, tourCalendario, tourEmpresa];
const tourSizes = "(min-width: 1024px) 1000px, 100vw";
---

<section class="relative pt-12 pb-24 lg:pt-20 lg:pb-32 overflow-hidden bg-grid-pattern" id="hero">
  <div data-parallax="0.1" class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-orange-400/15 via-blue-500/10 to-transparent blur-3xl pointer-events-none rounded-full -z-10"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-orange-200 bg-orange-50/80 backdrop-blur text-xs font-semibold text-orange-600 mb-6 shadow-sm">
      <span class="flex h-2 w-2 rounded-full bg-orange-500 animate-pulse"></span>
      <span>{hero.badge}</span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15] max-w-4xl mx-auto mb-6">
      {hero.titleLine1} <br class="hidden sm:block" />
      <span class="text-gradient-orange">{hero.titleLine2}</span>
    </h1>
    <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mb-9 font-normal leading-relaxed">{hero.subtitle}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <a class="w-full sm:w-auto px-8 py-3.5 rounded-xl text-white font-semibold text-base runly-gradient-btn shadow-md" href="#modulos">{hero.ctaPrimary}</a>
      <a class="w-full sm:w-auto px-8 py-3.5 rounded-xl text-slate-700 bg-white/90 hover:bg-white border border-slate-300 font-semibold text-base backdrop-blur transition-all hover:border-slate-400 hover:shadow-sm" href="#contacto">{hero.ctaSecondary}</a>
    </div>
    <div class="flex items-center justify-center gap-3 sm:gap-6 text-xs sm:text-sm font-semibold text-slate-500 mb-14">
      <span class="flex items-center gap-1.5"><Boxes class="w-4 h-4 text-orange-500" /> {hero.badgeModular}</span>
      <span class="text-slate-300">&bull;</span>
      <span class="flex items-center gap-1.5"><BuildingComplex class="w-4 h-4 text-blue-600" /> {hero.badgeMultiCompany}</span>
      <span class="text-slate-300">&bull;</span>
      <span class="flex items-center gap-1.5"><SlidersHorizontal class="w-4 h-4 text-emerald-500" /> {hero.badgeCustomizable}</span>
    </div>
    <div class="relative max-w-5xl mx-auto mt-6">
      <div class="flex justify-center mb-5">
        <div id="heroTourTabs" class="relative inline-flex items-center gap-1 p-1 rounded-full bg-slate-100/90 border border-slate-200 backdrop-blur" role="tablist" aria-label={hero.imageAlt}>
          <span id="heroTourIndicator" aria-hidden="true" class="absolute top-1 bottom-1 left-0 rounded-full bg-gradient-to-br from-[#ff5e14] to-[#ff9f1c] shadow-md shadow-orange-500/30 transition-[transform,width] duration-500 ease-[cubic-bezier(0.65,0,0.35,1)]"></span>
          {hero.tourTabs.map((tab, i) => (
            <button
              type="button"
              class="hero-tour-tab relative z-10 overflow-hidden px-4 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition-colors duration-300 data-[active=true]:text-white data-[active=false]:text-slate-600 data-[active=false]:hover:text-slate-900"
              data-active={i === 0 ? "true" : "false"}
              data-index={i}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`heroTourPanel-${i}`}
            >
              {tab.label}
              <span aria-hidden="true" class="hero-tour-progress absolute left-3 right-3 bottom-1 h-0.5 rounded-full bg-white/80 origin-left scale-x-0"></span>
            </button>
          ))}
        </div>
      </div>
      <div class="relative rounded-2xl p-2 sm:p-3 bg-gradient-to-b from-slate-200 via-slate-100 to-slate-200/50 shadow-2xl border border-slate-300/60">
        <div class="bg-slate-900 rounded-xl overflow-hidden shadow-inner border border-slate-800">
          <div class="h-9 px-4 bg-slate-950/80 flex items-center justify-between border-b border-slate-800/80">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
              <Lock class="w-3 h-3 text-emerald-400" />
              <span>{hero.windowUrl}</span>
            </div>
            <div class="w-10"></div>
          </div>
          <div id="heroTourStage" class="relative overflow-hidden bg-slate-50" style={`aspect-ratio: ${tourInicio.width} / ${tourInicio.height}`}>
            {tourImages.map((img, i) => (
              <Image
                id={`heroTourPanel-${i}`}
                src={img}
                alt={hero.tourTabs[i]?.alt ?? hero.imageAlt}
                widths={[640, 1000, 1500, 1912]}
                sizes={tourSizes}
                format="webp"
                quality={80}
                loading="eager"
                fetchpriority={i === 0 ? "high" : "low"}
                decoding="async"
                role="tabpanel"
                aria-hidden={i === 0 ? "false" : "true"}
                data-active={i === 0 ? "true" : "false"}
                class="hero-tour-image absolute inset-0 w-full h-full object-cover object-top select-none transition-[opacity,transform,filter] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[active=true]:opacity-100 data-[active=true]:scale-100 data-[active=true]:blur-0 data-[active=false]:opacity-0 data-[active=false]:scale-[1.03] data-[active=false]:blur-sm motion-reduce:transition-none"
              />
            ))}
          </div>
        </div>
      </div>
      <div class="hidden lg:flex items-center gap-3 absolute -left-6 top-1/4 p-3.5 rounded-xl glass-card shadow-glass border border-white/90">
        <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
          <Network class="w-5 h-5" />
        </div>
        <div class="text-left">
          <p class="text-xs font-semibold text-slate-900">{hero.floatingMultiBranchTitle}</p>
          <p class="text-[11px] text-slate-500">{hero.floatingMultiBranchSubtitle}</p>
        </div>
      </div>
      <div class="hidden lg:flex items-center gap-3 absolute -right-6 bottom-1/4 p-3.5 rounded-xl glass-card shadow-glass border border-white/90">
        <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
          <Sparkles class="w-5 h-5" />
        </div>
        <div class="text-left">
          <p class="text-xs font-semibold text-slate-900">{hero.floatingMiraiTitle}</p>
          <p class="text-[11px] text-emerald-600 font-medium">&#9679; {hero.floatingMiraiSubtitle}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const INTERVAL_MS = 5000;

  const tabList = document.getElementById("heroTourTabs");
  const indicator = document.getElementById("heroTourIndicator");
  const stage = document.getElementById("heroTourStage");
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".hero-tour-tab"));
  const images = Array.from(document.querySelectorAll<HTMLImageElement>(".hero-tour-image"));
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (tabList && indicator && stage && tabs.length && tabs.length === images.length) {
    let current = 0;
    let progressAnim: Animation | null = null;
    let hovered = false;
    let visible = true;
    let stopped = prefersReducedMotion;

    const moveIndicator = () => {
      const tab = tabs[current];
      indicator.style.width = `${tab.offsetWidth}px`;
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    // Drives autoplay: when the progress bar under the active tab finishes
    // filling, advance. Pausing the animation pauses the carousel with it.
    const startProgress = () => {
      progressAnim?.cancel();
      progressAnim = null;
      if (stopped) return;
      const bar = tabs[current].querySelector<HTMLElement>(".hero-tour-progress");
      if (!bar) return;
      progressAnim = bar.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
        duration: INTERVAL_MS,
        easing: "linear",
      });
      progressAnim.onfinish = () => show((current + 1) % tabs.length);
      syncPlayState();
    };

    const syncPlayState = () => {
      if (!progressAnim) return;
      if (hovered || !visible || document.hidden) progressAnim.pause();
      else progressAnim.play();
    };

    const show = (index: number) => {
      current = index;
      tabs.forEach((t, i) => {
        const active = i === index;
        t.dataset.active = String(active);
        t.setAttribute("aria-selected", String(active));
        t.tabIndex = active ? 0 : -1;
      });
      images.forEach((img, i) => {
        const active = i === index;
        img.dataset.active = String(active);
        img.setAttribute("aria-hidden", String(!active));
      });
      moveIndicator();
      startProgress();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        // A deliberate choice by the visitor ends autoplay for good.
        stopped = true;
        show(i);
      });
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const next = (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        stopped = true;
        show(next);
        tabs[next].focus();
      });
    });

    for (const el of [tabList, stage]) {
      el.addEventListener("mouseenter", () => { hovered = true; syncPlayState(); });
      el.addEventListener("mouseleave", () => { hovered = false; syncPlayState(); });
    }
    document.addEventListener("visibilitychange", syncPlayState);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      syncPlayState();
    }, { threshold: 0.25 }).observe(stage);

    window.addEventListener("resize", moveIndicator);
    // Tab widths depend on the webfont; re-measure once it has loaded.
    document.fonts?.ready.then(moveIndicator);
    // Place the indicator without sliding it in from the left on first paint.
    indicator.style.transition = "none";
    show(0);
    requestAnimationFrame(() => requestAnimationFrame(() => indicator.style.removeProperty("transition")));
  }
</script>
