---
// src/components/layout/Header.astro
import { Menu, X, ArrowRight } from "@lucide/astro";
import type { NavDictionary } from "../../i18n/types";

interface Props {
  locale: "es" | "en";
  nav: NavDictionary;
}

const { locale, nav } = Astro.props;
const prefix = locale === "es" ? "" : "/en";
const langSwitcher = [
  { code: "es" as const, href: "/", label: "ES" },
  { code: "en" as const, href: "/en/", label: "EN" },
];

const links = [
  { href: `${prefix}/#hero`, label: nav.platform },
  { href: `${prefix}/#modulos`, label: nav.modules },
  { href: `${prefix}/#motor-rm3`, label: nav.rm3 },
  { href: `${prefix}/#mirai`, label: nav.mirai, badge: "IA" },
  { href: `${prefix}/#implementacion`, label: nav.implementation },
  { href: `${prefix}/#contacto`, label: nav.contact },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <a aria-label="RUNLY" class="flex items-center gap-2" href={`${prefix}/`}>
      <img alt="RUNLY - Business in motion" class="h-9 w-auto object-contain" src="/brand/runly-logo-light.png" width="140" height="36" />
    </a>
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-sm font-semibold text-slate-600">
      {links.map((link) => (
        <a class="hover:text-runly-orange transition-colors flex items-center gap-1.5 whitespace-nowrap" href={link.href}>
          <span>{link.label}</span>
          {link.badge && (
            <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-purple-100 text-purple-700">{link.badge}</span>
          )}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3 sm:gap-4">
      <div class="hidden sm:flex items-center gap-0.5 text-xs font-bold rounded-full border border-slate-200 p-0.5" aria-label="Language">
        {langSwitcher.map((item) => (
          <a
            href={item.href}
            class={`px-2.5 py-1 rounded-full transition-colors ${locale === item.code ? "bg-slate-900 text-white" : "text-slate-500 hover:text-slate-900"}`}
            aria-current={locale === item.code ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
      <a class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-medium text-sm runly-gradient-btn shadow-sm whitespace-nowrap" href={`${prefix}/#contacto`}>
        <span>{nav.requestDemo}</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
      <button aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu" class="lg:hidden relative p-2 text-slate-700 hover:text-runly-orange rounded-lg focus:outline-none" id="mobileMenuBtn">
        <Menu class="menu-icon-open w-6 h-6" />
        <X class="menu-icon-close w-6 h-6 absolute inset-0 m-auto" />
      </button>
    </div>
  </div>
  <div class="mobile-nav-panel lg:hidden absolute inset-x-0 top-full z-40 border-t border-slate-200 bg-white/95 backdrop-blur-lg px-4 pt-3 pb-6 space-y-3 shadow-lg" id="mobileMenu">
    {links.map((link) => (
      <a class="block py-2 text-sm font-medium text-slate-700 hover:text-runly-orange" href={link.href}>{link.label}</a>
    ))}
    <div class="flex items-center gap-1 text-xs font-bold rounded-full border border-slate-200 p-0.5 w-fit" aria-label="Language">
      {langSwitcher.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-1 rounded-full transition-colors ${locale === item.code ? "bg-slate-900 text-white" : "text-slate-500 hover:text-slate-900"}`}
          aria-current={locale === item.code ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
    <a class="w-full text-center py-3 rounded-xl text-white font-medium text-sm runly-gradient-btn block mt-2" href={`${prefix}/#contacto`}>
      {nav.requestDemo}
    </a>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById("mobileMenuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  if (mobileBtn && mobileMenu) {
    const closeMenu = () => {
      mobileMenu.classList.remove("is-open");
      mobileBtn.setAttribute("aria-expanded", "false");
    };
    mobileBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = mobileMenu.classList.toggle("is-open");
      mobileBtn.setAttribute("aria-expanded", String(isOpen));
    });
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
    document.addEventListener("click", (e) => {
      if (!mobileMenu.contains(e.target as Node) && !mobileBtn.contains(e.target as Node)) {
        closeMenu();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });
  }
</script>
