---
// src/components/docs/DocsSearchTrigger.astro
//
// Button that opens the page's <DocsSearch /> dialog. "hero" is the large
// search bar on the docs home; "compact" fits a sidebar.
import { Search } from "@lucide/astro";

interface Props {
  variant?: "hero" | "compact";
  class?: string;
}

const { variant = "compact", class: className = "" } = Astro.props;
const hero = variant === "hero";
---

<button
  type="button"
  data-docs-search-open
  class:list={[
    "group flex w-full items-center gap-3 border bg-white text-left text-slate-400 transition hover:border-orange-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400",
    hero
      ? "h-14 rounded-2xl border-slate-200 px-5 text-base shadow-[0_10px_30px_-12px_rgba(11,19,43,0.18)] hover:shadow-glow-orange"
      : "h-10 rounded-xl border-slate-200 px-3 text-sm",
    className,
  ]}
>
  <Search class={hero ? "h-5 w-5 text-orange-500" : "h-4 w-4"} />
  <span class="flex-1 truncate">{hero ? "Busca un módulo, una pantalla o una tarea…" : "Buscar…"}</span>
  <kbd class="hidden sm:inline-flex items-center gap-0.5 rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-[11px] font-semibold text-slate-500">
    <span data-docs-search-mod>Ctrl</span> K
  </kbd>
</button>
