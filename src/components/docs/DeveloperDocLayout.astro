---
// Shared shell for /documentacion/desarrolladores pages: header, sidebar
// with the docs search and every developer page (by `order`), the rendered
// markdown and a link to the page's Markdown version for AI assistants.
import { getCollection } from "astro:content";
import { ChevronRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../layout/Header.astro";
import Footer from "../layout/Footer.astro";
import DocsSearch from "./DocsSearch.astro";
import DocsSearchTrigger from "./DocsSearchTrigger.astro";
import { getDictionary } from "../../i18n";
import { resolveIcon } from "../../lib/icons";
import { developerPageIcon } from "../../lib/docs-catalog";
import { developerDocHref } from "../../lib/docs-content";

interface Props {
  title: string;
  summary: string;
  slug: string;
}

const { title, summary, slug } = Astro.props;
const locale = "es" as const;
const dict = getDictionary(locale);
const pages = (await getCollection("developers")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`${title} — Desarrolladores Runly`} description={summary} locale={locale} path={developerDocHref(slug)}>
  <Header locale={locale} nav={dict.nav} />
  <main class="bg-white pb-16 pt-24 sm:pb-20 sm:pt-28" style="--mod:#ff5e14">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:px-8">
      <nav class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto" aria-label="Documentación de desarrolladores">
        <DocsSearchTrigger />
        <p class="mt-6 text-[11px] font-bold uppercase tracking-widest text-slate-400">Desarrolladores</p>
        <ul class="mt-2 space-y-0.5">
          {pages.map((page) => {
            const PageIcon = resolveIcon(developerPageIcon(page.id));
            return (
              <li>
                <a
                  href={developerDocHref(page.id)}
                  aria-current={page.id === slug ? "true" : undefined}
                  class="doc-toc-link flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
                >
                  <PageIcon class="doc-toc-icon h-4 w-4 shrink-0 text-slate-400" />
                  <span class="truncate">{page.data.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="mt-6 text-xs leading-relaxed text-slate-500">
          Para asistentes de IA: <a class="text-orange-600 hover:underline" href="/llms.txt">llms.txt</a> ·
          <a class="text-orange-600 hover:underline" href={`/documentacion/desarrolladores/${slug}.md`}>esta página en Markdown</a>
        </p>
      </nav>
      <article class="min-w-0">
        <nav aria-label="Ruta" class="flex flex-wrap items-center gap-1 text-xs font-semibold text-slate-500">
          <a href="/documentacion/modulos" class="hover:text-slate-900">Documentación</a>
          <ChevronRight class="h-3.5 w-3.5" />
          <a href={developerDocHref("index")} class="hover:text-slate-900">Desarrolladores</a>
        </nav>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{title}</h1>
        <p class="mt-2 text-base leading-relaxed text-slate-600">{summary}</p>
        <div class="doc-prose mt-8">
          <slot />
        </div>
      </article>
    </div>
  </main>
  <Footer locale={locale} footer={dict.footer} />
  <DocsSearch />
</BaseLayout>
