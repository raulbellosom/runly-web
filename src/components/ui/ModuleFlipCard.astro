---
// src/components/ui/ModuleFlipCard.astro
//
// A single cell in a seamless mosaic grid (see ModulesFullCatalogSection /
// ModulesCatalogSection: gap-px on the grid + a shared background color
// showing through as hairlines, so cells read as one continuous panel
// rather than separate floating cards). No per-cell border/shadow/radius —
// only the outer grid container is rounded.
//
// Flips on hover (desktop, via CSS :hover) or tap (touch, via a JS-toggled
// .is-flipped class — both paths converge on the same rotateY(180deg)
// target so they never compound). Front: icon + name + one-line summary.
// Back: full description + a link into that module's public docs
// (src/pages/documentacion/modulos/[modulo].astro).
import { resolveIcon } from "../../lib/icons";
import type { RunlyModuleEntry } from "../../data/modules";

interface Props {
  module: RunlyModuleEntry;
  locale: "es" | "en";
}

const { module: mod, locale } = Astro.props;
const Icon = resolveIcon(mod.icon);
const docsLabel = locale === "es" ? "Ver documentación" : "View documentation";
---

<div
  class="flip-card group relative h-40 sm:h-44 cursor-pointer outline-none"
  data-category={mod.category}
  role="button"
  tabindex="0"
  aria-pressed="false"
  aria-label={`${mod.name[locale]} — ${docsLabel}`}
>
  <div class="flip-card-inner relative w-full h-full">
    <div class="flip-card-face absolute inset-0 bg-white p-4 flex flex-col justify-start focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-orange-400">
      <div
        class="w-9 h-9 rounded-lg text-white flex items-center justify-center mb-2 shrink-0"
        style={`background-color:${mod.color}`}
      >
        <Icon class="w-4 h-4" />
      </div>
      <h3 class="font-bold text-slate-900 text-sm leading-tight">{mod.name[locale]}</h3>
      <p class="text-xs text-slate-500 leading-snug mt-1 line-clamp-3">{mod.description[locale]}</p>
    </div>

    <div
      class="flip-card-face flip-card-back absolute inset-0 text-white p-4 flex flex-col justify-between"
      style={`background-color:${mod.color}`}
    >
      <div>
        <h3 class="font-bold text-sm leading-tight mb-1.5">{mod.name[locale]}</h3>
        <p class="text-xs leading-relaxed text-white/90 line-clamp-4">{mod.description[locale]}</p>
      </div>
      <a
        href={`/documentacion/modulos/${mod.id}`}
        class="doc-link inline-flex items-center gap-1 text-xs font-semibold text-white hover:underline w-fit"
      >
        {docsLabel}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<style>
  .flip-card {
    perspective: 1200px;
  }

  .flip-card-inner {
    transform-style: preserve-3d;
    transition: transform 0.4s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .flip-card:hover .flip-card-inner {
      transform: rotateY(180deg);
    }
  }

  .flip-card.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-face {
    backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }

  /* Hidden backfaces can still be hit-tested (notably iOS Safari), so once
     flipped the front face must stop taking taps meant for the back's link. */
  .flip-card.is-flipped .flip-card-face:not(.flip-card-back) {
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .flip-card:hover .flip-card-face:not(.flip-card-back) {
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner {
      transition: none;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".flip-card");
  cards.forEach((card) => {
    const toggle = () => {
      const flipped = card.classList.toggle("is-flipped");
      card.setAttribute("aria-pressed", String(flipped));
    };
    card.addEventListener("click", toggle);
    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggle();
      }
    });
    card.querySelector(".doc-link")?.addEventListener("click", (event) => {
      event.stopPropagation();
    });
  });
</script>
