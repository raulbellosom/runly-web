---
// /documentacion/desarrolladores/<slug> — one developer doc page per
// docs/developers/<slug>.md in the runly repo.
export const prerender = true;

import { getCollection, render } from "astro:content";
import DeveloperDocLayout from "../../../components/docs/DeveloperDocLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("developers");
  return entries
    .filter((entry) => entry.id !== "index")
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DeveloperDocLayout title={entry.data.title} summary={entry.data.summary} slug={entry.id}>
  <Content />
</DeveloperDocLayout>
