---
// src/pages/data-security.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import LegalContent from "../components/sections/LegalContent.astro";
import { getDictionary } from "../i18n";

export const prerender = true;

const locale = "es" as const;
const dict = getDictionary(locale);
const page = dict.legal.security;
---

<BaseLayout title={page.metaTitle} description={page.metaDescription} locale={locale} path="/data-security">
  <Header locale={locale} nav={dict.nav} />
  <main>
    <LegalContent page={page} />
  </main>
  <Footer locale={locale} footer={dict.footer} />
</BaseLayout>
