---
// Runtime-resolved Marketplace module page (?key=custom.x): unlisted links and
// releases newer than the last build. Rendered in the browser from Developer
// Hub and never indexed.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import MarketplaceModuleDetail from "../../components/marketplace/MarketplaceModuleDetail.astro";
import { getDictionary } from "../../i18n";
import { MARKETPLACE_TEXT } from "../../lib/marketplace";

export const prerender = true;
const locale = "es" as const;
const dict = getDictionary(locale);
const t = MARKETPLACE_TEXT[locale];
---

<BaseLayout title={t.detailMetaSuffix} description={t.description} locale={locale} path="/modulos/detalle" noindex>
  <Header locale={locale} nav={dict.nav} />
  <main class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <MarketplaceModuleDetail locale={locale} />
    </div>
  </main>
  <Footer locale={locale} footer={dict.footer} />
</BaseLayout>
